# Database and authentication
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DATABASE_REJECT_UNAUTHORIZED=false
JWT_SECRET=replace-with-at-least-32-random-characters

# Server-side upload integration (never prefix these with NEXT_PUBLIC_)
UPLOAD_API_URL=https://t-union.jp/upload.php
UPLOAD_API_KEY=replace-with-rotated-api-key
UPLOAD_BASIC_USER=replace-with-upload-user
UPLOAD_BASIC_PASSWORD=replace-with-rotated-password

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-rotated-public-key
VAPID_PRIVATE_KEY=replace-with-rotated-private-key
VAPID_SUBJECT=mailto:admin@example.com
