# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temporary scripts & debug files
tmp_*.js
debug_*.js
test_*.js
run-migration*.js
server_log*.txt
*_result*.json

# local credentials and database inspection output
/vapid_keys.json
/users_pw.json
/results.json
/results_refs.json
/db_output*.json
/schema_check.json
/test_results.txt
/list_users_pw.js
